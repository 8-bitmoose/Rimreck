RIMRECK_MODE=personal
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Hosted mode database
DATABASE_URL=postgresql://rimreck:rimreck@db:5432/rimreck

# Personal mode filesystem defaults
RIMRECK_PERSONAL_HOME=~/.rimreck
RIMRECK_PERSONAL_DB=~/.rimreck/db.sqlite3
RIMRECK_PERSONAL_MEDIA=~/.rimreck/media

# Email (hosted mode)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com
